# URL pública definitiva do site (usada em canonical, sitemap, Open Graph e JSON-LD).
# Ex.: https://www.seudominio.com.br — sem barra no final.
# Na Vercel, se ficar vazio, o domínio de produção do projeto é usado automaticamente.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager (formato GTM-XXXXXXX). Deixe vazio para não carregar.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 direto (formato G-XXXXXXXXXX). Use apenas se NÃO usar o GTM.
NEXT_PUBLIC_GA_ID=
